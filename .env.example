# Used by `docker compose` for variable substitution (${VAR}) in docker-compose.yml.
# Copy to .env in this same folder and fill in real values before `docker compose up`.

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# The origin the browser will actually use to reach the frontend, e.g. http://192.168.200.45
CORS_ORIGIN=
